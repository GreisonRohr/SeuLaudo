# Chave da API da Anthropic (leitura e interpretação com o Claude)
ANTHROPIC_API_KEY=
# Modelo e esforço de raciocínio (low | medium | high | xhigh | max)
SEULAUDO_CLAUDE_MODEL=claude-opus-5-5
SEULAUDO_EFFORT_LEITURA=high
SEULAUDO_EFFORT_INTERPRETACAO=high
# Pasta dos dados (banco SQLite e laudos enviados)
SEULAUDO_DADOS=./dados
# Senha de acesso ao site (HTTP Basic). Vazio = sem senha (apenas para testes locais)
SEULAUDO_USUARIO=seulaudo
SEULAUDO_SENHA=
